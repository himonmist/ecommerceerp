// Link Vision Commerce — Phase 1 schema (tenancy, catalogue, inventory, orders).
// Mirrors docs/vendrdesk-analysis/04-DATABASE.md. Every tenant-owned table carries
// tenant_id and is protected by FORCE ROW LEVEL SECURITY (see migrations/*_rls).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Platform & tenancy ─────────────────────────

model Tenant {
  id           String    @id @default(uuid(7)) @db.Uuid
  slug         String    @unique
  name         String
  ownerUserId  String    @map("owner_user_id") @db.Uuid
  template     String    @default("aurora")
  currency     String    @default("BDT") @db.Char(3)
  timezone     String    @default("Asia/Dhaka")
  status       String    @default("trial") // trial|active|read_only|suspended
  trialEndsAt  DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  contactEmail String?   @map("contact_email")
  contactPhone String?   @map("contact_phone")
  tagline      String?
  announcement String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner         User           @relation("TenantOwner", fields: [ownerUserId], references: [id])
  domains       Domain[]
  memberships   Membership[]
  roles         Role[]
  subscriptions Subscription[]
  modules       TenantModule[]

  @@map("tenants")
}

model Domain {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  hostname   String    @unique
  isPrimary  Boolean   @default(false) @map("is_primary")
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("domains")
}

model User {
  id               String    @id @default(uuid(7)) @db.Uuid
  name             String
  email            String    @unique
  passwordHash     String    @map("password_hash")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  sessions     Session[]
  memberships  Membership[]
  ownedTenants Tenant[]     @relation("TenantOwner")

  @@map("users")
}

model Session {
  id        String   @id // SHA-256 of the opaque cookie token; raw token never stored
  userId    String   @map("user_id") @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  ip        String?
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Role {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  name        String
  isSystem    Boolean      @default(false) @map("is_system")
  permissions String[]
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Membership {
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid
  status   String @default("active")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role   @relation(fields: [roleId], references: [id])

  @@id([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model Plan {
  id           String         @id @default(uuid(7)) @db.Uuid
  code         String         @unique
  name         String
  priceMonthly Decimal        @map("price_monthly") @db.Decimal(18, 2)
  priceYearly  Decimal        @map("price_yearly") @db.Decimal(18, 2)
  maxProducts  Int?           @map("max_products") // null = unlimited
  maxSeats     Int?           @map("max_seats")
  features     String[]
  sortOrder    Int            @default(0) @map("sort_order")
  subs         Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String   @id @default(uuid(7)) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  planId             String   @map("plan_id") @db.Uuid
  cycle              String   @default("monthly")
  status             String   @default("trialing") // trialing|active|past_due|cancelled
  currentPeriodStart DateTime @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime @map("current_period_end") @db.Timestamptz(6)
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               Plan     @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@map("subscriptions")
}

model TenantModule {
  tenantId String  @map("tenant_id") @db.Uuid
  module   String
  enabled  Boolean @default(true)
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, module])
  @@map("tenant_modules")
}

model DocumentSequence {
  tenantId  String @map("tenant_id") @db.Uuid
  docType   String @map("doc_type")
  prefix    String
  nextValue Int    @default(1) @map("next_value")

  @@id([tenantId, docType])
  @@map("document_sequences")
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorType  String   @map("actor_type") // user|system|customer
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model RateLimit {
  key         String   @id
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int

  @@map("rate_limits")
}

// ───────────────────────── Catalogue & inventory ─────────────────────────

model Category {
  id          String     @id @default(uuid(7)) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  parentId    String?    @map("parent_id") @db.Uuid
  name        String
  slug        String
  description String?
  imageUrl    String?    @map("image_url")
  sortOrder   Int        @default(0) @map("sort_order")
  status      String     @default("active") // active|draft
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@unique([tenantId, slug])
  @@map("categories")
}

model Brand {
  id       String    @id @default(uuid(7)) @db.Uuid
  tenantId String    @map("tenant_id") @db.Uuid
  name     String
  products Product[]

  @@unique([tenantId, name])
  @@map("brands")
}

model Product {
  id               String           @id @default(uuid(7)) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  name             String
  slug             String
  categoryId       String?          @map("category_id") @db.Uuid
  brandId          String?          @map("brand_id") @db.Uuid
  channel          String           @default("omni") // omni|online|offline
  shortDescription String?          @map("short_description")
  description      String?
  unit             String           @default("pcs")
  vatRate          Decimal          @default(0) @map("vat_rate") @db.Decimal(5, 2)
  seoTitle         String?          @map("seo_title")
  seoDescription   String?          @map("seo_description")
  status           String           @default("active") // draft|active|archived
  isFeatured       Boolean          @default(false) @map("is_featured")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand            Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants         ProductVariant[]
  images           ProductImage[]

  @@unique([tenantId, slug])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid(7)) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  url       String
  sortOrder Int     @default(0) @map("sort_order")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariant {
  id                String              @id @default(uuid(7)) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  productId         String              @map("product_id") @db.Uuid
  title             String              @default("Default")
  sku               String?
  barcode           String?
  options           Json                @default("{}")
  costPrice         Decimal             @default(0) @map("cost_price") @db.Decimal(18, 2)
  onlinePrice       Decimal             @map("online_price") @db.Decimal(18, 2)
  compareAtPrice    Decimal?            @map("compare_at_price") @db.Decimal(18, 2)
  offlinePrice      Decimal?            @map("offline_price") @db.Decimal(18, 2)
  lowStockThreshold Int                 @default(5) @map("low_stock_threshold")
  isDefault         Boolean             @default(true) @map("is_default")
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockLevels       StockLevel[]
  orderItems        OrderItem[]
  quotationItems    QuotationItem[]
  invoiceItems      SalesInvoiceItem[]
  poItems           PurchaseOrderItem[]
  billItems         PurchaseBillItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([productId])
  @@map("product_variants")
}

model Warehouse {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  name        String
  type        String       @default("warehouse") // warehouse|showroom
  address     String?
  isDefault   Boolean      @default(false) @map("is_default")
  stockLevels StockLevel[]

  @@unique([tenantId, name])
  @@map("warehouses")
}

model StockLevel {
  tenantId    String         @map("tenant_id") @db.Uuid
  variantId   String         @map("variant_id") @db.Uuid
  warehouseId String         @map("warehouse_id") @db.Uuid
  onHand      Int            @default(0) @map("on_hand")
  reserved    Int            @default(0)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([tenantId, variantId, warehouseId])
  @@map("stock_levels")
}

model StockMovement {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  type        String // opening|sale|sales_return|adjustment_in|adjustment_out
  qtyChange   Int      @map("qty_change")
  qtyBefore   Int      @map("qty_before")
  qtyAfter    Int      @map("qty_after")
  sourceType  String   @map("source_type")
  sourceId    String?  @map("source_id")
  reference   String?
  notes       String?
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, variantId, createdAt])
  @@map("stock_movements")
}

// ───────────────────────── Customers & orders ─────────────────────────

model Customer {
  id             String            @id @default(uuid(7)) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  name           String
  phone          String
  email          String?
  address        String?
  city           String?
  district       String?
  membershipId   String?           @map("membership_id")
  customerTypeId String?           @map("customer_type_id") @db.Uuid
  creditLimit    Decimal           @default(0) @map("credit_limit") @db.Decimal(18, 2) // 0 = no limit (as in the reference app)
  openingDue     Decimal           @default(0) @map("opening_due") @db.Decimal(18, 2) // remaining opening receivable
  advanceBalance Decimal           @default(0) @map("advance_balance") @db.Decimal(18, 2)
  status         String            @default("active")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  orders         Order[]
  customerType   CustomerType?     @relation(fields: [customerTypeId], references: [id], onDelete: SetNull)
  quotations     Quotation[]
  invoices       SalesInvoice[]
  receipts       CustomerReceipt[]
  salesReturns   SalesReturn[]

  @@unique([tenantId, phone])
  @@map("customers")
}

model ShippingZone {
  id        String  @id @default(uuid(7)) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  name      String
  charge    Decimal @db.Decimal(18, 2)
  eta       String?
  sortOrder Int     @default(0) @map("sort_order")
  enabled   Boolean @default(true)
  orders    Order[]

  @@unique([tenantId, name])
  @@map("shipping_zones")
}

model Coupon {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  code         String
  discountType String    @map("discount_type") // percent|fixed
  value        Decimal   @db.Decimal(18, 2)
  minOrder     Decimal   @default(0) @map("min_order") @db.Decimal(18, 2)
  usageLimit   Int?      @map("usage_limit")
  used         Int       @default(0)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  isActive     Boolean   @default(true) @map("is_active")
  orders       Order[]

  @@unique([tenantId, code])
  @@map("coupons")
}

model Order {
  id              String        @id @default(uuid(7)) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  number          String
  channel         String        @default("storefront") // storefront|pos|erp|manual
  customerId      String?       @map("customer_id") @db.Uuid
  warehouseId     String        @map("warehouse_id") @db.Uuid
  status          String        @default("pending")
  paymentStatus   String        @default("unpaid") @map("payment_status") // unpaid|paid|refunded
  paymentMethod   String        @default("cod") @map("payment_method")
  shippingName    String        @map("shipping_name")
  shippingPhone   String        @map("shipping_phone")
  shippingAddress String        @map("shipping_address")
  shippingZoneId  String?       @map("shipping_zone_id") @db.Uuid
  subtotal        Decimal       @db.Decimal(18, 2)
  discount        Decimal       @default(0) @db.Decimal(18, 2)
  shippingFee     Decimal       @default(0) @map("shipping_fee") @db.Decimal(18, 2)
  total           Decimal       @db.Decimal(18, 2)
  couponId        String?       @map("coupon_id") @db.Uuid
  notes           String?
  ip              String?
  placedAt        DateTime      @default(now()) @map("placed_at") @db.Timestamptz(6)
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shippingZone    ShippingZone? @relation(fields: [shippingZoneId], references: [id], onDelete: SetNull)
  coupon          Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  events          OrderEvent[]

  @@unique([tenantId, number])
  @@index([tenantId, status, placedAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id           String         @id @default(uuid(7)) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  orderId      String         @map("order_id") @db.Uuid
  variantId    String         @map("variant_id") @db.Uuid
  name         String
  variantTitle String         @map("variant_title")
  qty          Int
  unitPrice    Decimal        @map("unit_price") @db.Decimal(18, 2)
  unitCost     Decimal        @default(0) @map("unit_cost") @db.Decimal(18, 2)
  lineTotal    Decimal        @map("line_total") @db.Decimal(18, 2)
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

model OrderEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  note       String?
  actorId    String?  @map("actor_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_events")
}

// ───────────────────────── ERP: sales ─────────────────────────

model CustomerType {
  id          String     @id @default(uuid(7)) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  name        String
  code        String?
  discountPct Decimal    @default(0) @map("discount_pct") @db.Decimal(5, 2)
  creditDays  Int        @default(0) @map("credit_days")
  description String?
  isActive    Boolean    @default(true) @map("is_active")
  customers   Customer[]

  @@unique([tenantId, name])
  @@map("customer_types")
}

model Quotation {
  id                 String          @id @default(uuid(7)) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  number             String
  customerId         String          @map("customer_id") @db.Uuid
  date               DateTime        @db.Date
  validUntil         DateTime?       @map("valid_until") @db.Date
  subtotal           Decimal         @db.Decimal(18, 2)
  vatTotal           Decimal         @default(0) @map("vat_total") @db.Decimal(18, 2)
  discount           Decimal         @default(0) @db.Decimal(18, 2)
  additionalCharge   Decimal         @default(0) @map("additional_charge") @db.Decimal(18, 2)
  total              Decimal         @db.Decimal(18, 2)
  terms              String?
  status             String          @default("draft") // draft|sent|accepted|rejected|converted
  convertedInvoiceId String?         @map("converted_invoice_id") @db.Uuid
  createdBy          String?         @map("created_by") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  customer           Customer        @relation(fields: [customerId], references: [id])
  items              QuotationItem[]

  @@unique([tenantId, number])
  @@map("quotations")
}

model QuotationItem {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  quotationId String         @map("quotation_id") @db.Uuid
  variantId   String         @map("variant_id") @db.Uuid
  description String
  qty         Int
  unitPrice   Decimal        @map("unit_price") @db.Decimal(18, 2)
  discount    Decimal        @default(0) @db.Decimal(18, 2)
  vatPct      Decimal        @default(0) @map("vat_pct") @db.Decimal(5, 2)
  lineTotal   Decimal        @map("line_total") @db.Decimal(18, 2)
  quotation   Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@map("quotation_items")
}

model SalesInvoice {
  id               String              @id @default(uuid(7)) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  number           String
  customerId       String?             @map("customer_id") @db.Uuid // null = walk-in (must be fully paid)
  customerName     String              @map("customer_name")
  warehouseId      String              @map("warehouse_id") @db.Uuid
  quotationId      String?             @map("quotation_id") @db.Uuid
  channel          String              @default("erp") // erp|pos
  shiftId          String?             @map("shift_id") @db.Uuid
  invoiceDate      DateTime            @map("invoice_date") @db.Date
  dueDate          DateTime?           @map("due_date") @db.Date
  subtotal         Decimal             @db.Decimal(18, 2)
  vatTotal         Decimal             @default(0) @map("vat_total") @db.Decimal(18, 2)
  discount         Decimal             @default(0) @db.Decimal(18, 2)
  additionalCharge Decimal             @default(0) @map("additional_charge") @db.Decimal(18, 2)
  total            Decimal             @db.Decimal(18, 2)
  paid             Decimal             @default(0) @db.Decimal(18, 2)
  returned         Decimal             @default(0) @db.Decimal(18, 2) // value credited back by returns
  status           String              @default("posted") // posted|void
  paymentStatus    String              @default("unpaid") @map("payment_status") // unpaid|partial|paid
  notes            String?
  createdBy        String?             @map("created_by") @db.Uuid
  journalId        String?             @map("journal_id") @db.Uuid // reserved for Phase 3 ledger posting
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  customer         Customer?           @relation(fields: [customerId], references: [id])
  items            SalesInvoiceItem[]
  allocations      ReceiptAllocation[]
  returns          SalesReturn[]

  @@unique([tenantId, number])
  @@index([tenantId, customerId, invoiceDate])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  invoiceId   String         @map("invoice_id") @db.Uuid
  variantId   String         @map("variant_id") @db.Uuid
  description String
  qty         Int
  returnedQty Int            @default(0) @map("returned_qty")
  unitPrice   Decimal        @map("unit_price") @db.Decimal(18, 2)
  discount    Decimal        @default(0) @db.Decimal(18, 2)
  vatPct      Decimal        @default(0) @map("vat_pct") @db.Decimal(5, 2)
  lineTotal   Decimal        @map("line_total") @db.Decimal(18, 2)
  unitCost    Decimal        @default(0) @map("unit_cost") @db.Decimal(18, 2)
  invoice     SalesInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@map("sales_invoice_items")
}

model CustomerReceipt {
  id          String              @id @default(uuid(7)) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  number      String
  customerId  String?             @map("customer_id") @db.Uuid
  date        DateTime            @db.Date
  method      String // cash|bank|bkash|nagad|card|cheque
  reference   String?
  amount      Decimal             @db.Decimal(18, 2)
  toAdvance   Decimal             @default(0) @map("to_advance") @db.Decimal(18, 2)
  fromAdvance Decimal             @default(0) @map("from_advance") @db.Decimal(18, 2)
  status      String              @default("posted") // posted|void
  notes       String?
  createdBy   String?             @map("created_by") @db.Uuid
  journalId   String?             @map("journal_id") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  customer    Customer?           @relation(fields: [customerId], references: [id])
  allocations ReceiptAllocation[]

  @@unique([tenantId, number])
  @@map("customer_receipts")
}

model ReceiptAllocation {
  id        String          @id @default(uuid(7)) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  receiptId String          @map("receipt_id") @db.Uuid
  invoiceId String?         @map("invoice_id") @db.Uuid // null = applied to the opening balance
  amount    Decimal         @db.Decimal(18, 2)
  receipt   CustomerReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoice   SalesInvoice?   @relation(fields: [invoiceId], references: [id])

  @@map("receipt_allocations")
}

model SalesReturn {
  id           String            @id @default(uuid(7)) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  number       String
  invoiceId    String            @map("invoice_id") @db.Uuid
  customerId   String?           @map("customer_id") @db.Uuid
  date         DateTime          @db.Date
  amount       Decimal           @db.Decimal(18, 2)
  reduceDue    Decimal           @default(0) @map("reduce_due") @db.Decimal(18, 2)
  toAdvance    Decimal           @default(0) @map("to_advance") @db.Decimal(18, 2)
  refundAmount Decimal           @default(0) @map("refund_amount") @db.Decimal(18, 2)
  restock      Boolean           @default(true)
  reason       String
  createdBy    String?           @map("created_by") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  invoice      SalesInvoice      @relation(fields: [invoiceId], references: [id])
  customer     Customer?         @relation(fields: [customerId], references: [id])
  items        SalesReturnItem[]

  @@unique([tenantId, number])
  @@map("sales_returns")
}

model SalesReturnItem {
  id            String      @id @default(uuid(7)) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  returnId      String      @map("return_id") @db.Uuid
  invoiceItemId String      @map("invoice_item_id") @db.Uuid
  qty           Int
  amount        Decimal     @db.Decimal(18, 2)
  salesReturn   SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@map("sales_return_items")
}

// ───────────────────────── ERP: purchase ─────────────────────────

model SupplierType {
  id          String     @id @default(uuid(7)) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  name        String
  code        String?
  description String?
  isActive    Boolean    @default(true) @map("is_active")
  suppliers   Supplier[]

  @@unique([tenantId, name])
  @@map("supplier_types")
}

model Supplier {
  id             String            @id @default(uuid(7)) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  supplierTypeId String?           @map("supplier_type_id") @db.Uuid
  name           String
  contactPerson  String?           @map("contact_person")
  phone          String?
  email          String?
  address        String?
  openingDue     Decimal           @default(0) @map("opening_due") @db.Decimal(18, 2) // remaining opening payable
  advanceBalance Decimal           @default(0) @map("advance_balance") @db.Decimal(18, 2)
  status         String            @default("active")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  supplierType   SupplierType?     @relation(fields: [supplierTypeId], references: [id], onDelete: SetNull)
  purchaseOrders PurchaseOrder[]
  receipts       GoodsReceipt[]
  bills          PurchaseBill[]
  payments       SupplierPayment[]
  returns        PurchaseReturn[]

  @@unique([tenantId, name])
  @@map("suppliers")
}

model PurchaseOrder {
  id               String              @id @default(uuid(7)) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  number           String
  supplierId       String              @map("supplier_id") @db.Uuid
  warehouseId      String              @map("warehouse_id") @db.Uuid
  orderDate        DateTime            @map("order_date") @db.Date
  expectedDate     DateTime?           @map("expected_date") @db.Date
  subtotal         Decimal             @db.Decimal(18, 2)
  vatTotal         Decimal             @default(0) @map("vat_total") @db.Decimal(18, 2)
  discount         Decimal             @default(0) @db.Decimal(18, 2)
  additionalCharge Decimal             @default(0) @map("additional_charge") @db.Decimal(18, 2)
  total            Decimal             @db.Decimal(18, 2)
  terms            String?
  status           String              @default("issued") // issued|partially_received|received|cancelled
  createdBy        String?             @map("created_by") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  items            PurchaseOrderItem[]
  receipts         GoodsReceipt[]

  @@unique([tenantId, number])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  poId        String         @map("po_id") @db.Uuid
  variantId   String         @map("variant_id") @db.Uuid
  description String
  qty         Int
  receivedQty Int            @default(0) @map("received_qty")
  unitCost    Decimal        @map("unit_cost") @db.Decimal(18, 2)
  discount    Decimal        @default(0) @db.Decimal(18, 2)
  vatPct      Decimal        @default(0) @map("vat_pct") @db.Decimal(5, 2)
  lineTotal   Decimal        @map("line_total") @db.Decimal(18, 2)
  po          PurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@map("purchase_order_items")
}

model GoodsReceipt {
  id           String             @id @default(uuid(7)) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  number       String
  poId         String             @map("po_id") @db.Uuid
  supplierId   String             @map("supplier_id") @db.Uuid
  receivedDate DateTime           @map("received_date") @db.Date
  billId       String?            @map("bill_id") @db.Uuid
  notes        String?
  createdBy    String?            @map("created_by") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  po           PurchaseOrder      @relation(fields: [poId], references: [id])
  supplier     Supplier           @relation(fields: [supplierId], references: [id])
  items        GoodsReceiptItem[]

  @@unique([tenantId, number])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id        String       @id @default(uuid(7)) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  grnId     String       @map("grn_id") @db.Uuid
  poItemId  String       @map("po_item_id") @db.Uuid
  variantId String       @map("variant_id") @db.Uuid
  qty       Int
  unitCost  Decimal      @map("unit_cost") @db.Decimal(18, 2)
  grn       GoodsReceipt @relation(fields: [grnId], references: [id], onDelete: Cascade)

  @@map("goods_receipt_items")
}

model PurchaseBill {
  id               String              @id @default(uuid(7)) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  number           String
  supplierBillNo   String?             @map("supplier_bill_no")
  supplierId       String              @map("supplier_id") @db.Uuid
  warehouseId      String              @map("warehouse_id") @db.Uuid
  grnId            String?             @map("grn_id") @db.Uuid // set when billed from a goods receipt (stock already in)
  billDate         DateTime            @map("bill_date") @db.Date
  dueDate          DateTime?           @map("due_date") @db.Date
  subtotal         Decimal             @db.Decimal(18, 2)
  vatTotal         Decimal             @default(0) @map("vat_total") @db.Decimal(18, 2)
  discount         Decimal             @default(0) @db.Decimal(18, 2)
  additionalCharge Decimal             @default(0) @map("additional_charge") @db.Decimal(18, 2)
  total            Decimal             @db.Decimal(18, 2)
  paid             Decimal             @default(0) @db.Decimal(18, 2)
  returned         Decimal             @default(0) @db.Decimal(18, 2)
  status           String              @default("posted") // posted|void
  paymentStatus    String              @default("unpaid") @map("payment_status")
  notes            String?
  createdBy        String?             @map("created_by") @db.Uuid
  journalId        String?             @map("journal_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  items            PurchaseBillItem[]
  allocations      PaymentAllocation[]
  returns          PurchaseReturn[]

  @@unique([tenantId, number])
  @@index([tenantId, supplierId, billDate])
  @@map("purchase_bills")
}

model PurchaseBillItem {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  billId      String         @map("bill_id") @db.Uuid
  variantId   String         @map("variant_id") @db.Uuid
  description String
  qty         Int
  returnedQty Int            @default(0) @map("returned_qty")
  unitCost    Decimal        @map("unit_cost") @db.Decimal(18, 2)
  discount    Decimal        @default(0) @db.Decimal(18, 2)
  vatPct      Decimal        @default(0) @map("vat_pct") @db.Decimal(5, 2)
  lineTotal   Decimal        @map("line_total") @db.Decimal(18, 2)
  bill        PurchaseBill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@map("purchase_bill_items")
}

model SupplierPayment {
  id          String              @id @default(uuid(7)) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  number      String
  supplierId  String              @map("supplier_id") @db.Uuid
  date        DateTime            @db.Date
  method      String
  reference   String?
  amount      Decimal             @db.Decimal(18, 2)
  toAdvance   Decimal             @default(0) @map("to_advance") @db.Decimal(18, 2)
  fromAdvance Decimal             @default(0) @map("from_advance") @db.Decimal(18, 2)
  status      String              @default("posted")
  notes       String?
  createdBy   String?             @map("created_by") @db.Uuid
  journalId   String?             @map("journal_id") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  allocations PaymentAllocation[]

  @@unique([tenantId, number])
  @@map("supplier_payments")
}

model PaymentAllocation {
  id        String          @id @default(uuid(7)) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  paymentId String          @map("payment_id") @db.Uuid
  billId    String?         @map("bill_id") @db.Uuid // null = applied to the opening balance
  amount    Decimal         @db.Decimal(18, 2)
  payment   SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill      PurchaseBill?   @relation(fields: [billId], references: [id])

  @@map("payment_allocations")
}

model PurchaseReturn {
  id           String               @id @default(uuid(7)) @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  number       String
  billId       String               @map("bill_id") @db.Uuid
  supplierId   String               @map("supplier_id") @db.Uuid
  date         DateTime             @db.Date
  amount       Decimal              @db.Decimal(18, 2)
  reduceDue    Decimal              @default(0) @map("reduce_due") @db.Decimal(18, 2)
  toAdvance    Decimal              @default(0) @map("to_advance") @db.Decimal(18, 2)
  refundAmount Decimal              @default(0) @map("refund_amount") @db.Decimal(18, 2)
  reason       String
  createdBy    String?              @map("created_by") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  bill         PurchaseBill         @relation(fields: [billId], references: [id])
  supplier     Supplier             @relation(fields: [supplierId], references: [id])
  items        PurchaseReturnItem[]

  @@unique([tenantId, number])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id             String         @id @default(uuid(7)) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  returnId       String         @map("return_id") @db.Uuid
  billItemId     String         @map("bill_item_id") @db.Uuid
  qty            Int
  amount         Decimal        @db.Decimal(18, 2)
  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@map("purchase_return_items")
}

// ───────────────────────── Accounting (double-entry) ─────────────────────────

model LedgerSettings {
  tenantId      String    @id @map("tenant_id") @db.Uuid
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  lockedThrough DateTime? @map("locked_through") @db.Date // no postings dated on/before this day

  @@map("ledger_settings")
}

model Account {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  code        String
  name        String
  nature      String // asset|liability|equity|income|expense
  groupName   String        @map("group_name")
  systemKey   String?       @map("system_key")
  kind        String? // cash|bank|wallet for money accounts
  description String?
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  lines       JournalLine[]

  @@unique([tenantId, code])
  @@unique([tenantId, systemKey])
  @@map("accounts")
}

model Journal {
  id                String        @id @default(uuid(7)) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  number            String
  voucherType       String        @map("voucher_type") // CV|DV|JV|TM|SYS
  date              DateTime      @db.Date
  description       String
  reference         String?
  sourceType        String?       @map("source_type")
  sourceId          String?       @map("source_id") @db.Uuid
  status            String        @default("approved") // draft|approved|verified|cancelled
  amount            Decimal       @db.Decimal(18, 2) // total debits
  reversesJournalId String?       @map("reverses_journal_id") @db.Uuid
  reversedById      String?       @map("reversed_by_id") @db.Uuid
  cancelReason      String?       @map("cancel_reason")
  createdBy         String?       @map("created_by") @db.Uuid
  verifiedBy        String?       @map("verified_by") @db.Uuid
  verifiedAt        DateTime?     @map("verified_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  lines             JournalLine[]

  @@unique([tenantId, number])
  @@index([tenantId, date])
  @@index([tenantId, sourceType, sourceId])
  @@map("journals")
}

model JournalLine {
  id        String  @id @default(uuid(7)) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  journalId String  @map("journal_id") @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  debit     Decimal @default(0) @db.Decimal(18, 2)
  credit    Decimal @default(0) @db.Decimal(18, 2)
  partyType String? @map("party_type") // customer|supplier
  partyId   String? @map("party_id") @db.Uuid
  memo      String?
  journal   Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account   Account @relation(fields: [accountId], references: [id])

  @@index([tenantId, accountId])
  @@index([journalId])
  @@map("journal_lines")
}

// ───────────────────────── POS & multi-location ─────────────────────────

model PosRegister {
  id          String     @id @default(uuid(7)) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  name        String
  warehouseId String     @map("warehouse_id") @db.Uuid
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  shifts      PosShift[]

  @@unique([tenantId, name])
  @@map("pos_registers")
}

model PosShift {
  id           String            @id @default(uuid(7)) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  number       String
  registerId   String            @map("register_id") @db.Uuid
  status       String            @default("open") // open|closed
  openingFloat Decimal           @map("opening_float") @db.Decimal(18, 2)
  openedBy     String            @map("opened_by") @db.Uuid
  openedAt     DateTime          @default(now()) @map("opened_at") @db.Timestamptz(6)
  expectedCash Decimal?          @map("expected_cash") @db.Decimal(18, 2)
  countedCash  Decimal?          @map("counted_cash") @db.Decimal(18, 2)
  variance     Decimal?          @db.Decimal(18, 2)
  closedBy     String?           @map("closed_by") @db.Uuid
  closedAt     DateTime?         @map("closed_at") @db.Timestamptz(6)
  notes        String?
  register     PosRegister       @relation(fields: [registerId], references: [id])
  movements    PosCashMovement[]

  @@unique([tenantId, number])
  @@index([registerId, status])
  @@map("pos_shifts")
}

model PosCashMovement {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  shiftId   String   @map("shift_id") @db.Uuid
  type      String // cash_drop|pay_in|pay_out
  amount    Decimal  @db.Decimal(18, 2)
  reason    String
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  shift     PosShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@map("pos_cash_movements")
}

model StockTransfer {
  id              String              @id @default(uuid(7)) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  number          String
  fromWarehouseId String              @map("from_warehouse_id") @db.Uuid
  toWarehouseId   String              @map("to_warehouse_id") @db.Uuid
  date            DateTime            @db.Date
  carrier         String?
  notes           String?
  createdBy       String?             @map("created_by") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  items           StockTransferItem[]

  @@unique([tenantId, number])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String        @id @default(uuid(7)) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  transferId String        @map("transfer_id") @db.Uuid
  variantId  String        @map("variant_id") @db.Uuid
  qty        Int
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@map("stock_transfer_items")
}
